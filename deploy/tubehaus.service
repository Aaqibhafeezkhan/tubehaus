[Unit]
Description=TubeHaus server
After=network-online.target warp-svc.service
Wants=network-online.target

[Service]
EnvironmentFile=/opt/tubehaus/.env
WorkingDirectory=/opt/tubehaus
ExecStart=/usr/bin/python3 /opt/tubehaus/server/tubehaus_server.py
Restart=always
RestartSec=3
# warp-cli (for HT_WARP_ROTATE) needs no root; the server never does either
DynamicUser=yes
StateDirectory=tubehaus
Environment=HT_STATE=/var/lib/tubehaus

[Install]
WantedBy=multi-user.target
